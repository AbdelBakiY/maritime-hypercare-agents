# Copy to `.env` and fill in. Only needed when running OUTSIDE Snowflake
# (local Streamlit, FastAPI, scripts). Never commit your real .env file.

# --- Snowflake connection (Snowpark) --------------------------------------
SNOWFLAKE_ACCOUNT=myorg-myaccount          # account identifier, e.g. abc12345.eu-west-1 or ORG-ACCOUNT
SNOWFLAKE_USER=MY_USER
# Programmatic Access Token (Snowsight > Settings > Authentication). Used both
# for the SQL connection and for the Cortex LLM endpoint.
SNOWFLAKE_PAT=
# SNOWFLAKE_PASSWORD=                      # alternative to the PAT for SQL only
# SNOWFLAKE_AUTHENTICATOR=externalbrowser  # e.g. SSO
SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
# Or reuse an entry of ~/.snowflake/connections.toml instead of the vars above:
# SNOWFLAKE_CONNECTION_NAME=default

# --- Project objects (must match the sql/ scripts) ------------------------
HYPERCARE_DATABASE=HYPERCARE_DB
HYPERCARE_SCHEMA=PUBLIC
HYPERCARE_SEARCH_SERVICE=KNOWLEDGE_BASE

# --- LLM -------------------------------------------------------------------
# snowflake = Cortex AI Gateway (default) | openai = any OpenAI-compatible API
LLM_PROVIDER=snowflake
LLM_MODEL=openai-gpt-5.4
# LLM_BASE_URL=https://<account>.snowflakecomputing.com/api/v2/cortex/v1   # override the endpoint

# Only when LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=
